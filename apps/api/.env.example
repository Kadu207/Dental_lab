PORT=3333

# standalone | embedded
DENTAL_LAB_DEPLOYMENT_MODE=standalone

# sqlite (dev) | postgres (produção / integrado)
DENTAL_LAB_DB_DRIVER=sqlite

# Postgres standalone: postgresql://user:pass@localhost:5433/dental_lab
# Postgres embedded: mesmo banco do ERP (schema dental_lab)
# DENTAL_LAB_DATABASE_URL=postgresql://dental_lab:dental_lab@localhost:5433/dental_lab

# Embedded: URL do Postgres do Excellence (tabela usuario). Se vazio, usa DATABASE_URL.
# DENTAL_LAB_ERP_DATABASE_URL=postgresql://excellence:excellence@localhost:5432/excellence

# Mesmo SECRET_KEY do Excellence (embedded)
# DENTAL_LAB_ERP_JWT_SECRET=

DENTAL_LAB_POSTGRES_SCHEMA=dental_lab
DENTAL_LAB_PLATFORM_SCHEMA=dental_lab_platform

# Senhas seed — defaults (supervisor123 / admin123) só fora de produção
# DENTAL_LAB_SUPERVISOR_PASSWORD=supervisor123
# DENTAL_LAB_PLATFORM_ADMIN_PASSWORD=admin123
# DENTAL_LAB_BOOTSTRAP_ADMIN_PASSWORD=admin123

# Em produção a API aborta se a lista estiver vazia ou for "*"
DENTAL_LAB_CORS_ORIGINS=http://localhost:5173

DENTAL_LAB_LICENSE_REQUIRED=false
DENTAL_LAB_LICENSE_KEY=

# Servidor remoto de licenças (Gerador de Licenças)
# Dev local: http://127.0.0.1:8195
# DENTAL_LAB_LICENSE_SERVER_URL=http://127.0.0.1:8195
# Produção: https://licencas.inovatitech.com.br
# DENTAL_LAB_LICENSE_SERVER_API_KEY=mesma-chave-do-PRODUCT_API_KEY-do-gerador
# DENTAL_LAB_TRIAL_DAYS=30

DENTAL_LAB_AUTH_REQUIRED=true

# PRODUÇÃO (obrigatório — a API aborta se faltar):
# DENTAL_LAB_JWT_SECRET=<secret-forte-min-32-chars-diferente-do-fallback-de-dev>
# DENTAL_LAB_BOOTSTRAP_ADMIN_PASSWORD=<senha-forte-nao-admin123>
# DENTAL_LAB_SUPERVISOR_PASSWORD=<senha-forte-nao-supervisor123>
# DENTAL_LAB_PLATFORM_ADMIN_PASSWORD=<senha-forte-nao-admin123>
# DENTAL_LAB_DATABASE_URL=postgresql://user:pass@host:5432/dental_lab
# DENTAL_LAB_CORS_ORIGINS=https://dentallab.inovatitech.com.br

DENTAL_LAB_JWT_SECRET=dev-lab-jwt-change-in-production
DENTAL_LAB_JWT_TTL_MINUTES=480

# DENTAL_LAB_SQLITE_PATH=

# URL pública do frontend (link no e-mail de recuperação de senha)
# DENTAL_LAB_APP_URL=https://dentallab.inovatitech.com.br

# SMTP — envio do link "Esqueceu a senha" (obrigatório em produção)
# DENTAL_LAB_SMTP_ENABLED=true
# DENTAL_LAB_SMTP_HOST=smtp.seudominio.com
# DENTAL_LAB_SMTP_PORT=587
# DENTAL_LAB_SMTP_SECURE=false
# DENTAL_LAB_SMTP_USER=
# DENTAL_LAB_SMTP_PASS=
# DENTAL_LAB_SMTP_FROM=Dental Lab <noreply@dentallab.inovatitech.com.br>
# Default false — não devolve resetToken na API (não depende de SMTP)
# DENTAL_LAB_PASSWORD_RESET_EXPOSE_TOKEN=false

# Integrações N8N / Chatwoot (Onda 3 — spec 012)
# INTEGRATIONS_ENABLED=true
# Em embedded, CRM fica no Excellence — só force se necessário:
# INTEGRATIONS_FORCE_IN_EMBEDDED=false
# N8N_WEBHOOK_URL=https://n8n.exemplo/webhook/dental-lab-n8n
# N8N_WEBHOOK_SECRET=
# CHATWOOT_WEBHOOK_URL=https://n8n.exemplo/webhook/dental-lab-chatwoot
# CHATWOOT_WEBHOOK_SECRET=

# Storage local — pasta digital do paciente / hot folders CAM (Onda 4 — spec 010)
# DENTAL_LAB_STORAGE_ROOT=./data/lab

